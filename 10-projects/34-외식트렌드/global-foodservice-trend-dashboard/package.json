{
  "name": "global-foodservice-trend-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "collect": "tsx scripts/collect.ts",
    "collect:dry": "tsx scripts/collect.ts --dry-run",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync.ps1",
    "deploy": "vercel deploy --prod --yes",
    "connect:git": "node scripts/vercel-git.mjs connect",
    "git:status": "node scripts/vercel-git.mjs status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
